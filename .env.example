# ============================================
# PH Gestión — Environment Variables
# Copy this to .env and fill in the values
# ============================================

# Demo Mode: DEMO_MODE=true deja entrar sin contraseña. Solo para desarrollo local.
# En producción debe ser false o no estar (en Vercel production el arranque falla si está en true).
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-domain.com"

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host-unpooled/dbname?sslmode=require"

# ePayco
EPAYCO_PUBLIC_KEY=""
EPAYCO_PRIVATE_KEY=""
EPAYCO_P_CUST_ID=""
EPAYCO_P_KEY=""
EPAYCO_TEST="true"

# Claude / Anthropic API
ANTHROPIC_API_KEY=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App URL — dirección pública de la app. Se usa en los enlaces de los correos (recuperar contraseña, portal de residentes,
# reuniones) y en los retornos/confirmación de ePayco. En producción es OBLIGATORIA (o al menos el dominio de Vercel):
# sin ella esos endpoints fallan a propósito en vez de mandar enlaces a localhost. Solo en desarrollo cae en http://localhost:3000.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Captcha anti-abuso (Cloudflare Turnstile) — OPCIONAL, para el registro y la recuperación de contraseña.
# Cloudflare dashboard > Turnstile > Add widget. Con TURNSTILE_SECRET_KEY vacía el captcha está APAGADO y todo funciona como siempre.
# Se configuran las DOS juntas: la pública (NEXT_PUBLIC_, se fija al compilar: requiere redeploy) muestra el widget en las pantallas;
# la secreta (solo servidor) valida el token. Si pones la secreta pero no la pública, nadie podrá registrarse (no habría widget).
# Si Cloudflare no responde, el servidor deja pasar (los límites por IP y por correo siguen aplicando).
# En desarrollo usa las llaves de prueba de Cloudflare:
#   sitio 1x00000000000000000000AA (siempre pasa) · secreta 1x0000000000000000000000000000000AA (siempre pasa)
#   (bloquea siempre: sitio 2x00000000000000000000AB · secreta 2x0000000000000000000000000000000AA)
# La CSP debe permitir https://challenges.cloudflare.com en script-src, frame-src y connect-src (ya está en src/lib/csp.ts).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Support — WhatsApp escalation link (used by chatbot and Configuracion page)
NEXT_PUBLIC_WHATSAPP_SUPPORT_URL="https://wa.me/573001112233"

# Support chatbot model (OpenAI). Defaults to gpt-4.1-nano.
SUPPORT_CHAT_MODEL="gpt-4.1-nano"

# ============================================
# Admin Console (admin subdomain)
# ============================================

# Comma-separated emails auto-promoted to admin on login (permanent admins).
# Runtime: takes effect on the next login, no redeploy needed.
# See docs/ADMIN_SETUP.md for the full flow.
ADMIN_EMAILS="tu-correo-de-login@dominio.com"

# Set to "true" to reach the admin panel at <main-host>/admin without a
# dedicated admin subdomain (still gated by requireAdmin). Redeploy after
# changing. Leave unset to keep admin on its own "admin." subdomain only.
# ALLOW_ADMIN_ON_MAIN_HOST="true"

# OPTIONAL. Only needed if the admin console lives on a host that does NOT start
# with "admin." — any "admin.*" host is auto-detected without this var. Must be
# a SEPARATE host from the main app (do NOT set it to your main domain).
# Build-time (NEXT_PUBLIC_): changing it requires a redeploy.
# NEXT_PUBLIC_ADMIN_HOSTNAME="admin.your-domain.com"

# OPTIONAL. Share the session across app+admin subdomains. Must start with a
# dot. Build-time: requires a redeploy. Leave unset to log in separately on the
# admin subdomain.
# COOKIE_DOMAIN=".your-domain.com"

# Dedicated secret for POST /api/admin/migrate (raw DDL runner).
# Generate with: openssl rand -base64 32  — never reuse AUTH_SECRET.
ADMIN_MIGRATE_SECRET=""

# Secret for Vercel Cron jobs (Authorization: Bearer <CRON_SECRET>). REQUIRED
# for the batch-generation queue (Élite) AND the 6-hourly health check — if it's
# missing, both crons return 401 and silently never run. Vercel sends this
# header automatically once the var is set. Generate with: openssl rand -base64 32.
CRON_SECRET=""

# ============================================
# Health monitoring
# ============================================
# The scheduled health check (/api/cron/health-check, every 6h) does a real AI
# round-trip + DB probe and EMAILS the addresses in ADMIN_EMAILS (see above)
# when a critical subsystem is down. Check status anytime at /api/health?deep=1
# (admin-only). This is what surfaces silent failures like a retired AI model.
